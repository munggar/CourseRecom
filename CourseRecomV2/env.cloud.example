DATABASE_URL=postgresql://postgres.<PROJECT_REF>:<URL_ENCODED_PASSWORD>@<POOLER_HOST>:5432/postgres?sslmode=require
ENVIRONMENT=production
SEED_DEMO_USERS=false
BOOTSTRAP_ADMIN_NIM=admin
BOOTSTRAP_ADMIN_NAME=Administrator
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-unique-password
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes
QR_VERIFICATION_SECRET=replace-with-a-different-random-secret-at-least-32-bytes
FRONTEND_URL=https://course.example.edu
PUBLIC_API_BASE_URL=https://api.example.edu/api
VITE_API_BASE_URL=/api
API_PROXY_TARGET=https://api.example.edu
VITE_ENVIRONMENT=production
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash-lite
RECOMMENDATION_WEIGHTS={"similar_students":0.30,"academic_history":0.25,"interest":0.20,"curriculum":0.15,"course_pattern":0.10}
PASSING_GRADES=A,A-,B+,B,B-,C+,C,C-
TOTAL_CURRICULUM_SKS=144
